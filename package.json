{
  "name": "cn.piaoztsdy.touchfish_ui_remake-2",
  "version": "0.0.1-alpha.1",
  "description": "A beautiful, modern TouchFish v5 client built with Electron.",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "Electron",
    "chat",
    "chat-app",
    "TouchFish",
    "TouchFish v5",
    "Luogu"
  ],
  "author": {
    "name": "Piaoztsdy",
    "email": "Piaoztsdy@outlook.com",
    "url": "https://www.piaoztsdy.cn/"
  },
  "license": "AGPL-3.0-only",
  "build": {
    "appId": "cn.piaoztsdy.touchfish_ui_remake-2",
    "productName": "Touchfish UI Remake 2",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/TouchFishUR.icns",
      "category": "public.app-category.communication",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": "nsis",
      "icon": "build/TouchFishUR.ico"
    },
    "nsis": {
      "include": "build/highdpi.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/TouchFishUR.ico",
      "uninstallerIcon": "build/TouchFishUR.ico",
      "uninstallDisplayName": "Touchfish UI Remake 2",
      "license": "LICENSE",
      "deleteAppDataOnUninstall": true
    },
    "icon": "build/TouchFishUR.ico",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/linux-icons",
      "category": "Network;Chat",
      "maintainer": "Piaoztsdy <Piaoztsdy@outlook.com>"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-x86_64.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.7.0",
    "svg-inline-loader": "^0.8.2"
  },
  "dependencies": {
    "@fluentui/svg-icons": "^1.1.318",
    "@pinyin-pro/data": "^1.3.1",
    "axios": "^1.19.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-katex": "^2.0.3",
    "pinyin-pro": "^3.28.1",
    "pkijs": "^3.4.0",
    "semver": "^7.6.0"
  }
}
